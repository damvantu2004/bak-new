ErrorDocument 404 /Application/Views/shared/site/404.php 
RewriteEngine On

RewriteRule ^captcha\.php$ - [L]

# Cho phép truy cập trực tiếp vào thư mục public
RewriteRule ^public/ - [L]

# Bỏ index.php khỏi URL nếu người dùng gõ thẳng
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/index\.php [NC]
RewriteRule ^index\.php(.*)$ $1 [R=301,L]

# Nếu không phải file hay thư mục thực, thì rewrite về index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route: /product/detail/{id}
RewriteRule ^product/detail/([0-9]+)/?$ index.php?controller=product&action=productDetail&id=$1 [QSA,L]

# Route: /product/allProducts/{id}
RewriteRule ^product/allProducts/([0-9]+)/?$ index.php?controller=product&action=allProducts&id=$1 [QSA,L]

# Route: /product/allProducts
RewriteRule ^product/allProducts/?$ index.php?controller=product&action=allProducts [QSA,L]

# Route: /customer/profile
RewriteRule ^customer/profile/?$ index.php?controller=customer&action=viewProfile [QSA,L]

# Route: /customer/orders
RewriteRule ^customer/orders/?$ index.php?controller=customer&action=listOrders [QSA,L]

# Route: /customer/update-profile
RewriteRule ^customer/update-profile/?$ index.php?controller=customer&action=updateProfile [QSA,L]

# Route: /customer/update-password
RewriteRule ^customer/update-password/?$ index.php?controller=customer&action=updatePassword [QSA,L]

# Route: /customer/order/detail/{id}
RewriteRule ^customer/order/detail/([0-9]+)/?$ index.php?controller=customer&action=orderDetail&id=$1 [QSA,L]

# Route: /checkout
RewriteRule ^checkout/?$ index.php?controller=checkout [QSA,L]

# Route: /verify/login
RewriteRule ^verify/login/?$ index.php?controller=verify&action=login [QSA,L]

# Route: /verify/logout
RewriteRule ^verify/logout/?$ index.php?controller=verify&action=logout [QSA,L]

# Route: /verify/forgot-password
RewriteRule ^verify/forgot-password/?$ index.php?controller=verify&action=forgotPassword [QSA,L]

# Route: /module/controller/action
RewriteRule ^([^/]+)/([^/]+)/([^/]+)/?$ index.php?module=$1&controller=$2&action=$3 [QSA,L]

# Route: /controller/action
RewriteRule ^([^/]+)/([^/]+)/?$ index.php?controller=$1&action=$2 [QSA,L]

# Route: /controller
RewriteRule ^([^/]+)/?$ index.php?controller=$1 [QSA,L]

RewriteRule ^$ index.php?controller=home [QSA,L]
